#!/usr/bin/env sh

set -eu

VERSION_AGY="1.1.11"              # https://github.com/google-antigravity/antigravity-cli
VERSION_CLANG_FORMAT="22.1.8"     # https://github.com/ssciwr/clang-format-wheel
VERSION_CMAKE="4.4.2"             # https://github.com/Kitware/CMake
VERSION_CODEX="0.147.0"           # https://github.com/openai/codex
VERSION_DATABRICKS_CLI="1.11.0"   # https://github.com/databricks/cli
VERSION_FD="10.4.2"               # https://github.com/sharkdp/fd
VERSION_FISH="4.8.1"              # https://github.com/fish-shell/fish-shell
VERSION_FZF="0.74.2"              # https://github.com/junegunn/fzf
VERSION_NEOVIM="0.12.4"           # https://github.com/neovim/neovim
VERSION_NODEJS="26.7.0"           # https://nodejs.org/dist/
VERSION_ORG_TOOLS="0.1.4"         # https://github.com/lino/org-tools
VERSION_PANDOC="3.10.1"           # https://github.com/jgm/pandoc
VERSION_RCLONE="1.75.0"           # https://github.com/rclone/rclone
VERSION_RIPGREP="15.2.0"          # https://github.com/burntsushi/ripgrep
VERSION_SHFMT="3.13.1"            # https://github.com/mvdan/sh
VERSION_SKIM="5.6.3"              # https://github.com/skim-rs/skim
VERSION_TMUX="3.7b"               # https://github.com/tmux/tmux-builds
VERSION_STYLUA="2.5.2"            # https://github.com/JohnnyMorganz/StyLua
VERSION_TOMBI="1.2.7"             # https://github.com/tombi-toml/tombi
VERSION_TREE_SITTER_CLI="0.26.12" # https://github.com/tree-sitter/tree-sitter
VERSION_TYPST="0.15.1"            # https://github.com/typst/typst

TOOL="${1:-}"
case "${TOOL}" in
agy | antigravity) TOOL="agy" ;;
clang-format | clangformat) TOOL="clang-format" ;;
cmake) ;;
codex) ;;
databricks-cli | databricks) TOOL="databricks-cli" ;;
fd) ;;
fish) ;;
fzf) ;;
neovim | nvim) TOOL="neovim" ;;
node | nodejs) TOOL="nodejs" ;;
org-tools | org) TOOL="org-tools" ;;
pandoc) ;;
rclone) ;;
ripgrep | rg) TOOL="ripgrep" ;;
shfmt) ;;
skim | sk) TOOL="skim" ;;
stylua) ;;
tmux) ;;
tombi) ;;
tree-sitter-cli | tree-sitter) TOOL="tree-sitter-cli" ;;
typst) ;;
*)
  printf "Usage: %s <agy|clang-format|cmake|codex|databricks-cli|fd|fish|fzf|neovim|nodejs|org-tools|pandoc|rclone|ripgrep|shfmt|skim|stylua|tmux|tombi|tree-sitter-cli|typst>\n" "$(basename "$0")" >&2
  exit 1
  ;;
esac

UNAME_S="$(uname -s)"
UNAME_M="$(uname -m)"

case "${UNAME_S}" in
Darwin) ;;
Linux) ;;
*)
  printf "Unsupported sysname: %s\n" "${UNAME_S}" >&2
  exit 1
  ;;
esac

case "${UNAME_M}" in
arm64 | aarch64) ARCH_FAMILY="arm64" ;;
x86_64 | x64) ARCH_FAMILY="x86_64" ;;
*)
  printf "Unsupported machine: %s\n" "${UNAME_M}" >&2
  exit 1
  ;;
esac

printf "Detected sysname/machine: %s/%s\n" "${UNAME_S}" "${UNAME_M}"

unsupported_platform() {
  printf "%s is not available for %s/%s\n" "${TOOL}" "${UNAME_S}" "${UNAME_M}" >&2
  exit 1
}

BIN_NAME=""
BIN_SUBPATH=""
OPT_SUBDIR=""
FLAT_RENAME=0
STRIP_SUBDIR=0
XATTR_NEEDED=0

case "${TOOL}" in
agy)
  VERSION="${VERSION_AGY}"
  BIN_NAME="agy"
  BIN_SUBPATH="antigravity"
  case "${UNAME_S}" in
  Darwin) SYSNAME="mac" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="x64" ;;
  esac
  URL="https://github.com/google-antigravity/antigravity-cli/releases/download/${VERSION}/agy_cli_${SYSNAME}_${MACHINE}.tar.gz"
  FLAT_RENAME=1
  ;;
clang-format)
  VERSION="${VERSION_CLANG_FORMAT}"
  BIN_NAME="clang-format"
  BIN_SUBPATH="clang_format/data/bin/clang-format"
  case "${UNAME_S}/${ARCH_FAMILY}" in
  Darwin/arm64)
    URL="https://files.pythonhosted.org/packages/2e/55/539cc1036dae16659f50500ca34838cc5b16cd3e98e3faaf164186b98093/clang_format-${VERSION}-py2.py3-none-macosx_11_0_arm64.whl"
    ;;
  Darwin/x86_64)
    URL="https://files.pythonhosted.org/packages/5d/d8/29b9db6098da1a011ca3f7560c3942fa81404dbbb4367c3bd1d5c435da3b/clang_format-${VERSION}-py2.py3-none-macosx_10_9_x86_64.whl"
    ;;
  Linux/arm64)
    URL="https://files.pythonhosted.org/packages/50/25/a9734da014eecc1f54c051ad643a28f2f6643dcc812ac59320e80e2b1a3b/clang_format-${VERSION}-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl"
    ;;
  Linux/x86_64)
    URL="https://files.pythonhosted.org/packages/e5/88/b82c066fa807da4ca2518fecf79071361f6324b77375e5e92c059c0697fd/clang_format-${VERSION}-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl"
    ;;
  *) unsupported_platform ;;
  esac
  FLAT_RENAME=1
  ;;
cmake)
  VERSION="${VERSION_CMAKE}"
  BIN_NAME="cmake"
  case "${UNAME_S}" in
  Darwin)
    SUFFIX="macos-universal"
    BIN_SUBPATH="CMake.app/Contents/bin/cmake"
    ;;
  Linux)
    BIN_SUBPATH="bin/cmake"
    case "${ARCH_FAMILY}" in
    arm64) SUFFIX="linux-aarch64" ;;
    x86_64) SUFFIX="linux-x86_64" ;;
    esac
    ;;
  esac
  URL="https://github.com/Kitware/CMake/releases/download/v${VERSION}/cmake-${VERSION}-${SUFFIX}.tar.gz"
  OPT_SUBDIR="cmake"
  ;;
codex)
  VERSION="${VERSION_CODEX}"
  BIN_NAME="codex"
  BIN_SUBPATH="codex"
  case "${ARCH_FAMILY}" in
  arm64) ARCH="aarch64" ;;
  x86_64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  BIN_SUBPATH="codex-${ARCH}-${PLATFORM}"
  URL="https://github.com/openai/codex/releases/download/rust-v${VERSION}/codex-${ARCH}-${PLATFORM}.tar.gz"
  FLAT_RENAME=1
  ;;
databricks-cli)
  VERSION="${VERSION_DATABRICKS_CLI}"
  BIN_NAME="databricks"
  BIN_SUBPATH="databricks"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/databricks/cli/releases/download/v${VERSION}/databricks_cli_${VERSION}_${SYSNAME}_${MACHINE}.zip"
  FLAT_RENAME=1
  ;;
fd)
  VERSION="${VERSION_FD}"
  BIN_NAME="fd"
  BIN_SUBPATH="fd"
  case "${UNAME_S}/${ARCH_FAMILY}" in
  Darwin/arm64)
    ARCH="aarch64"
    PLATFORM="apple-darwin"
    ;;
  Darwin/x86_64) unsupported_platform ;;
  Linux/arm64)
    ARCH="aarch64"
    PLATFORM="unknown-linux-musl"
    ;;
  Linux/x86_64)
    ARCH="x86_64"
    PLATFORM="unknown-linux-musl"
    ;;
  *) unsupported_platform ;;
  esac
  URL="https://github.com/sharkdp/fd/releases/download/v${VERSION}/fd-v${VERSION}-${ARCH}-${PLATFORM}.tar.gz"
  STRIP_SUBDIR=1
  ;;
fish)
  VERSION="${VERSION_FISH}"
  BIN_NAME="fish"
  case "${UNAME_S}/${ARCH_FAMILY}" in
  Darwin/arm64 | Darwin/x86_64)
    BIN_SUBPATH="Contents/Resources/base/usr/local/bin/fish"
    URL="https://github.com/fish-shell/fish-shell/releases/download/${VERSION}/fish-${VERSION}.app.zip"
    OPT_SUBDIR="fish"
    ;;
  Linux/arm64)
    BIN_SUBPATH="fish"
    URL="https://github.com/fish-shell/fish-shell/releases/download/${VERSION}/fish-${VERSION}-linux-aarch64.tar.xz"
    FLAT_RENAME=1
    ;;
  Linux/x86_64)
    BIN_SUBPATH="fish"
    URL="https://github.com/fish-shell/fish-shell/releases/download/${VERSION}/fish-${VERSION}-linux-x86_64.tar.xz"
    FLAT_RENAME=1
    ;;
  *) unsupported_platform ;;
  esac
  ;;
fzf)
  VERSION="${VERSION_FZF}"
  BIN_NAME="fzf"
  BIN_SUBPATH="fzf"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/junegunn/fzf/releases/download/v${VERSION}/fzf-${VERSION}-${SYSNAME}_${MACHINE}.tar.gz"
  ;;
neovim)
  VERSION="${VERSION_NEOVIM}"
  BIN_NAME="nvim"
  BIN_SUBPATH="bin/nvim"
  case "${UNAME_S}/${ARCH_FAMILY}" in
  Darwin/arm64)
    SYSNAME="macos"
    MACHINE="arm64"
    XATTR_NEEDED=1
    ;;
  Darwin/x86_64)
    SYSNAME="macos"
    MACHINE="x86_64"
    XATTR_NEEDED=1
    ;;
  Linux/arm64)
    SYSNAME="linux"
    MACHINE="arm64"
    ;;
  Linux/x86_64)
    SYSNAME="linux"
    MACHINE="x86_64"
    ;;
  *) unsupported_platform ;;
  esac
  URL="https://github.com/neovim/neovim/releases/download/v${VERSION}/nvim-${SYSNAME}-${MACHINE}.tar.gz"
  OPT_SUBDIR="nvim"
  ;;
nodejs)
  VERSION="${VERSION_NODEJS}"
  BIN_NAME="node"
  BIN_SUBPATH="bin/node"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="x64" ;;
  esac
  URL="https://nodejs.org/dist/v${VERSION}/node-v${VERSION}-${SYSNAME}-${MACHINE}.tar.gz"
  OPT_SUBDIR="node"
  ;;
org-tools)
  VERSION="${VERSION_ORG_TOOLS}"
  BIN_NAME="org"
  BIN_SUBPATH="org"
  case "${ARCH_FAMILY}" in
  arm64) ARCH="aarch64" ;;
  x86_64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  Linux) PLATFORM="unknown-linux-gnu" ;;
  esac
  URL="https://github.com/lino/org-tools/releases/download/v${VERSION}/org-${ARCH}-${PLATFORM}.tar.gz"
  FLAT_RENAME=1
  ;;
pandoc)
  VERSION="${VERSION_PANDOC}"
  BIN_NAME="pandoc"
  BIN_SUBPATH="bin/pandoc"
  case "${UNAME_S}/${ARCH_FAMILY}" in
  Darwin/arm64)
    URL="https://github.com/jgm/pandoc/releases/download/${VERSION}/pandoc-${VERSION}-arm64-macOS.zip"
    ;;
  Darwin/x86_64)
    URL="https://github.com/jgm/pandoc/releases/download/${VERSION}/pandoc-${VERSION}-x86_64-macOS.zip"
    ;;
  Linux/arm64)
    URL="https://github.com/jgm/pandoc/releases/download/${VERSION}/pandoc-${VERSION}-linux-arm64.tar.gz"
    ;;
  Linux/x86_64)
    URL="https://github.com/jgm/pandoc/releases/download/${VERSION}/pandoc-${VERSION}-linux-amd64.tar.gz"
    ;;
  *) unsupported_platform ;;
  esac
  STRIP_SUBDIR=1
  ;;
rclone)
  VERSION="${VERSION_RCLONE}"
  BIN_NAME="rclone"
  BIN_SUBPATH="rclone"
  case "${UNAME_S}" in
  Darwin) SYSNAME="osx" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/rclone/rclone/releases/download/v${VERSION}/rclone-v${VERSION}-${SYSNAME}-${MACHINE}.zip"
  STRIP_SUBDIR=1
  ;;
ripgrep)
  VERSION="${VERSION_RIPGREP}"
  BIN_NAME="rg"
  BIN_SUBPATH="rg"
  case "${ARCH_FAMILY}" in
  arm64) ARCH="aarch64" ;;
  x86_64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  URL="https://github.com/BurntSushi/ripgrep/releases/download/${VERSION}/ripgrep-${VERSION}-${ARCH}-${PLATFORM}.tar.gz"
  STRIP_SUBDIR=1
  ;;
shfmt)
  VERSION="${VERSION_SHFMT}"
  BIN_NAME="shfmt"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/mvdan/sh/releases/download/v${VERSION}/shfmt_v${VERSION}_${SYSNAME}_${MACHINE}"
  ;;
skim)
  VERSION="${VERSION_SKIM}"
  BIN_NAME="sk"
  BIN_SUBPATH="sk"
  case "${ARCH_FAMILY}" in
  arm64) ARCH="aarch64" ;;
  x86_64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  URL="https://github.com/skim-rs/skim/releases/download/v${VERSION}/skim-${ARCH}-${PLATFORM}.tar.xz"
  STRIP_SUBDIR=1
  ;;
stylua)
  VERSION="${VERSION_STYLUA}"
  BIN_NAME="stylua"
  BIN_SUBPATH="stylua"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="aarch64" ;;
  x86_64) MACHINE="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) URL="https://github.com/JohnnyMorganz/StyLua/releases/download/v${VERSION}/stylua-${SYSNAME}-${MACHINE}.zip" ;;
  Linux) URL="https://github.com/JohnnyMorganz/StyLua/releases/download/v${VERSION}/stylua-${SYSNAME}-${MACHINE}-musl.zip" ;;
  esac
  FLAT_RENAME=1
  ;;
tmux)
  VERSION="${VERSION_TMUX}"
  BIN_NAME="tmux"
  BIN_SUBPATH="tmux"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="x86_64" ;;
  esac
  URL="https://github.com/tmux/tmux-builds/releases/download/v${VERSION}/tmux-${VERSION}-${SYSNAME}-${MACHINE}.tar.gz"
  ;;
tombi)
  VERSION="${VERSION_TOMBI}"
  BIN_NAME="tombi"
  BIN_SUBPATH="tombi"
  case "${ARCH_FAMILY}" in
  arm64) ARCH="aarch64" ;;
  x86_64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  URL="https://github.com/tombi-toml/tombi/releases/download/v${VERSION}/tombi-cli-${VERSION}-${ARCH}-${PLATFORM}.tar.gz"
  STRIP_SUBDIR=1
  ;;
tree-sitter-cli)
  VERSION="${VERSION_TREE_SITTER_CLI}"
  BIN_NAME="tree-sitter"
  BIN_SUBPATH="tree-sitter"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${ARCH_FAMILY}" in
  arm64) MACHINE="arm64" ;;
  x86_64) MACHINE="x64" ;;
  esac
  URL="https://github.com/tree-sitter/tree-sitter/releases/download/v${VERSION}/tree-sitter-cli-${SYSNAME}-${MACHINE}.zip"
  ;;
typst)
  VERSION="${VERSION_TYPST}"
  BIN_NAME="typst"
  BIN_SUBPATH="typst"
  case "${ARCH_FAMILY}" in
  arm64) ARCH="aarch64" ;;
  x86_64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  URL="https://github.com/typst/typst/releases/download/v${VERSION}/typst-${ARCH}-${PLATFORM}.tar.xz"
  STRIP_SUBDIR=1
  ;;
esac

BIN_DIR="${HOME}/.local/bin"
mkdir -p "${BIN_DIR}"

case "${URL}" in
*.tar.gz)
  TMP_FILE="$(mktemp -t "${TOOL}.XXXXXX").tar.gz"
  TMP_DIR="$(mktemp -d -t "${TOOL}.XXXXXX")"
  cleanup() {
    rm -f "${TMP_FILE}"
    rm -rf "${TMP_DIR}"
  }
  trap cleanup EXIT
  printf "Downloading %s\n" "${URL}"
  curl -fLsS -o "${TMP_FILE}" "${URL}"
  if [ "${XATTR_NEEDED}" = "1" ]; then
    xattr -c "${TMP_FILE}"
  fi
  if [ "${FLAT_RENAME}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    tar -xzf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ -n "${OPT_SUBDIR}" ]; then
    OPT_DIR="${HOME}/.local/opt"
    mkdir -p "${OPT_DIR}"
    printf "Extracting to %s\n" "${OPT_DIR}/${OPT_SUBDIR}"
    tar -xzf "${TMP_FILE}" -C "${TMP_DIR}"
    rm -rf "${OPT_DIR:?}/${OPT_SUBDIR}"
    mv "${TMP_DIR}"/* "${OPT_DIR}/${OPT_SUBDIR}"
    ln -sf "${OPT_DIR}/${OPT_SUBDIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ "${STRIP_SUBDIR}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    tar -xzf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}"/*/"${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  else
    printf "Extracting to %s\n" "${BIN_DIR}"
    tar -xzf "${TMP_FILE}" -C "${BIN_DIR}"
  fi
  ;;
*.tar.xz)
  TMP_FILE="$(mktemp -t "${TOOL}.XXXXXX").tar.xz"
  TMP_DIR="$(mktemp -d -t "${TOOL}.XXXXXX")"
  cleanup() {
    rm -f "${TMP_FILE}"
    rm -rf "${TMP_DIR}"
  }
  trap cleanup EXIT
  printf "Downloading %s\n" "${URL}"
  curl -fLsS -o "${TMP_FILE}" "${URL}"
  printf "Extracting to %s\n" "${BIN_DIR}"
  if [ "${FLAT_RENAME}" = "1" ]; then
    tar -xJf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ "${STRIP_SUBDIR}" = "1" ]; then
    tar -xJf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}"/*/"${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  else
    tar -xJf "${TMP_FILE}" -C "${BIN_DIR}"
  fi
  ;;
*.zip | *.whl)
  TMP_FILE="$(mktemp -t "${TOOL}.XXXXXX").zip"
  TMP_DIR="$(mktemp -d -t "${TOOL}.XXXXXX")"
  cleanup() {
    rm -f "${TMP_FILE}"
    rm -rf "${TMP_DIR}"
  }
  trap cleanup EXIT
  printf "Downloading %s\n" "${URL}"
  curl -fLsS -o "${TMP_FILE}" "${URL}"
  if [ "${XATTR_NEEDED}" = "1" ]; then
    xattr -c "${TMP_FILE}"
  fi
  if [ "${FLAT_RENAME}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    unzip -q -o "${TMP_FILE}" -d "${TMP_DIR}"
    mv "${TMP_DIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ -n "${OPT_SUBDIR}" ]; then
    OPT_DIR="${HOME}/.local/opt"
    mkdir -p "${OPT_DIR}"
    printf "Extracting to %s\n" "${OPT_DIR}/${OPT_SUBDIR}"
    unzip -q -o "${TMP_FILE}" -d "${TMP_DIR}"
    rm -rf "${OPT_DIR:?}/${OPT_SUBDIR}"
    mv "${TMP_DIR}"/* "${OPT_DIR}/${OPT_SUBDIR}"
    ln -sf "${OPT_DIR}/${OPT_SUBDIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ "${STRIP_SUBDIR}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    unzip -q -o "${TMP_FILE}" -d "${TMP_DIR}"
    mv "${TMP_DIR}"/*/"${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  else
    printf "Extracting to %s\n" "${BIN_DIR}"
    unzip -q -o "${TMP_FILE}" -d "${BIN_DIR}"
  fi
  ;;
*)
  printf "Downloading %s to %s\n" "${URL}" "${BIN_DIR}"
  curl -fLsS -o "${BIN_DIR}/${BIN_NAME}" "${URL}"
  if [ "${XATTR_NEEDED}" = "1" ]; then
    xattr -c "${BIN_DIR}/${BIN_NAME}"
  fi
  ;;
esac

BIN_PATH="${BIN_DIR}/${BIN_NAME}"

chmod +x "${BIN_PATH}"
printf "Installed %s to %s\n" "${TOOL}" "${BIN_PATH}"

if [ "${TOOL}" = "nodejs" ]; then
  for extra_bin in npm npx; do
    ln -sf "${HOME}/.local/opt/node/bin/${extra_bin}" "${BIN_DIR}/${extra_bin}"
    printf "Also linked %s to %s\n" "${extra_bin}" "${BIN_DIR}/${extra_bin}"
  done
fi

if [ "${TOOL}" = "fish" ] && [ "${UNAME_S}" = "Darwin" ]; then
  for extra_bin in fish_indent fish_key_reader; do
    ln -sf "${HOME}/.local/opt/fish/Contents/Resources/base/usr/local/bin/${extra_bin}" "${BIN_DIR}/${extra_bin}"
    printf "Also linked %s to %s\n" "${extra_bin}" "${BIN_DIR}/${extra_bin}"
  done
fi

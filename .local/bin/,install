#!/usr/bin/env sh

set -eu

VERSION_CMAKE="4.3.3"            # https://github.com/Kitware/CMake
VERSION_CODEX="0.139.0"          # https://github.com/openai/codex
VERSION_DATABRICKS_CLI="1.2.1"   # https://github.com/databricks/cli
VERSION_FD="10.4.2"              # https://github.com/sharkdp/fd
VERSION_FISH="4.7.1"             # https://github.com/fish-shell/fish-shell
VERSION_FZF="0.73.1"             # https://github.com/junegunn/fzf
VERSION_NEOVIM="0.12.2"          # https://github.com/neovim/neovim
VERSION_NODEJS="26.3.0"          # https://nodejs.org/dist/
VERSION_RCLONE="1.74.3"          # https://github.com/rclone/rclone
VERSION_RIPGREP="15.1.0"         # https://github.com/burntsushi/ripgrep
VERSION_SKIM="4.7.0"             # https://github.com/skim-rs/skim
VERSION_TMUX="3.6b"              # https://github.com/tmux/tmux-builds
VERSION_STYLUA="2.5.2"           # https://github.com/JohnnyMorganz/StyLua
VERSION_TREE_SITTER_CLI="0.26.9" # https://github.com/tree-sitter/tree-sitter

TOOL="${1:-}"
case "${TOOL}" in
cmake) ;;
codex) ;;
databricks-cli | databricks) TOOL="databricks-cli" ;;
fd) ;;
fish) ;;
fzf) ;;
neovim | nvim) TOOL="neovim" ;;
node | nodejs) TOOL="nodejs" ;;
rclone) ;;
ripgrep | rg) TOOL="ripgrep" ;;
skim | sk) TOOL="skim" ;;
stylua) ;;
tmux) ;;
tree-sitter-cli | tree-sitter) TOOL="tree-sitter-cli" ;;
*)
  printf "Usage: %s <cmake|codex|databricks-cli|fd|fish|fzf|neovim|nodejs|rclone|ripgrep|skim|stylua|tmux|tree-sitter-cli>\n" "$(basename "$0")" >&2
  exit 1
  ;;
esac

UNAME_S="$(uname -s)"
UNAME_M="$(uname -m)"

case "${UNAME_S}" in
Darwin) ;;
Linux) ;;
*)
  printf "Unsupported sysname: %s\n" "${UNAME_S}" >&2
  exit 1
  ;;
esac

case "${UNAME_M}" in
arm64) ;;
# aarch64) ;;
x86_64 | x64) ;;
*)
  printf "Unsupported machine: %s\n" "${UNAME_M}" >&2
  exit 1
  ;;
esac

printf "Detected sysname/machine: %s/%s\n" "${UNAME_S}" "${UNAME_M}"

BIN_NAME=""
BIN_SUBPATH=""
OPT_SUBDIR=""
FLAT_RENAME=0
STRIP_SUBDIR=0
XATTR_NEEDED=0

case "${TOOL}" in
cmake)
  VERSION="${VERSION_CMAKE}"
  BIN_NAME="cmake"
  BIN_SUBPATH="bin/cmake"
  case "${UNAME_S}" in
  Darwin) SUFFIX="macos-universal" ;;
  Linux)
    case "${UNAME_M}" in
    arm64 | aarch64) SUFFIX="linux-aarch64" ;;
    x86_64 | x64) SUFFIX="linux-x86_64" ;;
    esac
    ;;
  esac
  URL="https://github.com/Kitware/CMake/releases/download/v${VERSION}/cmake-${VERSION}-${SUFFIX}.tar.gz"
  STRIP_SUBDIR=1
  ;;
codex)
  VERSION="${VERSION_CODEX}"
  BIN_NAME="codex"
  BIN_SUBPATH="codex"
  case "${UNAME_M}" in
  arm64 | aarch64) ARCH="aarch64" ;;
  # x86_64 | x64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  # Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  BIN_SUBPATH="codex-${ARCH}-${PLATFORM}"
  URL="https://github.com/openai/codex/releases/download/rust-v${VERSION}/codex-${ARCH}-${PLATFORM}.tar.gz"
  FLAT_RENAME=1
  ;;
databricks-cli)
  VERSION="${VERSION_DATABRICKS_CLI}"
  BIN_NAME="databricks"
  BIN_SUBPATH="databricks"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64 | aarch64) MACHINE="arm64" ;;
  x86_64 | x64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/databricks/cli/releases/download/v${VERSION}/databricks_cli_${VERSION}_${SYSNAME}_${MACHINE}.zip"
  FLAT_RENAME=1
  ;;
fd)
  VERSION="${VERSION_FD}"
  BIN_NAME="fd"
  BIN_SUBPATH="fd"
  case "${UNAME_M}" in
  arm64 | aarch64) ARCH="aarch64" ;;
  # x86_64 | x64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  # Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  URL="https://github.com/sharkdp/fd/releases/download/v${VERSION}/fd-v${VERSION}-${ARCH}-${PLATFORM}.tar.gz"
  STRIP_SUBDIR=1
  ;;
fish)
  VERSION="${VERSION_FISH}"
  BIN_NAME="fish"
  BIN_SUBPATH="Contents/Resources/base/usr/local/bin/fish"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macOS" ;;
  *)
    printf "fish zip is only for macOS\n" >&2
    exit 1
    ;;
  esac
  URL="https://github.com/fish-shell/fish-shell/releases/download/${VERSION}/fish-${VERSION}.app.zip"
  OPT_SUBDIR="fish"
  ;;
fzf)
  VERSION="${VERSION_FZF}"
  BIN_NAME="fzf"
  BIN_SUBPATH="fzf"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64) MACHINE="arm64" ;;
  # aarch64) MACHINE="arm64" ;;
  x86_64 | x64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/junegunn/fzf/releases/download/v${VERSION}/fzf-${VERSION}-${SYSNAME}_${MACHINE}.tar.gz"
  ;;
neovim)
  VERSION="${VERSION_NEOVIM}"
  BIN_NAME="nvim"
  BIN_SUBPATH="bin/nvim"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  # Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64) MACHINE="arm64" ;;
  # aarch64) MACHINE="arm64" ;;
  # x86_64 | x64) MACHINE="x86_64" ;;
  esac
  URL="https://github.com/neovim/neovim/releases/download/v${VERSION}/nvim-${SYSNAME}-${MACHINE}.tar.gz"
  OPT_SUBDIR="nvim"
  XATTR_NEEDED=1
  ;;
nodejs)
  VERSION="${VERSION_NODEJS}"
  BIN_NAME="node"
  BIN_SUBPATH="bin/node"
  case "${UNAME_S}" in
  Darwin) SYSNAME="darwin" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64 | aarch64) MACHINE="arm64" ;;
  x86_64 | x64) MACHINE="x64" ;;
  esac
  URL="https://nodejs.org/dist/v${VERSION}/node-v${VERSION}-${SYSNAME}-${MACHINE}.tar.gz"
  OPT_SUBDIR="node"
  ;;
rclone)
  VERSION="${VERSION_RCLONE}"
  BIN_NAME="rclone"
  BIN_SUBPATH="rclone"
  case "${UNAME_S}" in
  Darwin) SYSNAME="osx" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64 | aarch64) MACHINE="arm64" ;;
  x86_64 | x64) MACHINE="amd64" ;;
  esac
  URL="https://github.com/rclone/rclone/releases/download/v${VERSION}/rclone-v${VERSION}-${SYSNAME}-${MACHINE}.zip"
  STRIP_SUBDIR=1
  ;;
ripgrep)
  VERSION="${VERSION_RIPGREP}"
  BIN_NAME="rg"
  BIN_SUBPATH="rg"
  case "${UNAME_M}" in
  arm64 | aarch64) ARCH="aarch64" ;;
  # x86_64 | x64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  # Linux) PLATFORM="unknown-linux-musl" ;;
  esac
  URL="https://github.com/BurntSushi/ripgrep/releases/download/${VERSION}/ripgrep-${VERSION}-${ARCH}-${PLATFORM}.tar.gz"
  STRIP_SUBDIR=1
  ;;
skim)
  VERSION="${VERSION_SKIM}"
  BIN_NAME="sk"
  BIN_SUBPATH="sk"
  case "${UNAME_M}" in
  arm64 | aarch64) ARCH="aarch64" ;;
  # x86_64 | x64) ARCH="x86_64" ;;
  esac
  case "${UNAME_S}" in
  Darwin) PLATFORM="apple-darwin" ;;
  # Linux) PLATFORM="unknown-linux-gnu" ;;
  esac
  URL="https://github.com/skim-rs/skim/releases/download/v${VERSION}/skim-${ARCH}-${PLATFORM}.tar.xz"
  STRIP_SUBDIR=1
  ;;
stylua)
  VERSION="${VERSION_STYLUA}"
  BIN_NAME="stylua"
  BIN_SUBPATH="stylua"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64 | aarch64) MACHINE="aarch64" ;;
  x86_64 | x64) MACHINE="x86_64" ;;
  esac
  URL="https://github.com/JohnnyMorganz/StyLua/releases/download/v${VERSION}/stylua-${SYSNAME}-${MACHINE}.zip"
  FLAT_RENAME=1
  ;;
tmux)
  VERSION="${VERSION_TMUX}"
  BIN_NAME="tmux"
  BIN_SUBPATH="tmux"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  *)
    printf "tmux-builds only provides macOS binaries\n" >&2
    exit 1
    ;;
  esac
  case "${UNAME_M}" in
  arm64 | aarch64) MACHINE="arm64" ;;
  x86_64 | x64) MACHINE="x86_64" ;;
  esac
  URL="https://github.com/tmux/tmux-builds/releases/download/v${VERSION}/tmux-${VERSION}-${SYSNAME}-${MACHINE}.tar.gz"
  ;;
tree-sitter-cli)
  VERSION="${VERSION_TREE_SITTER_CLI}"
  BIN_NAME="tree-sitter"
  BIN_SUBPATH="tree-sitter"
  case "${UNAME_S}" in
  Darwin) SYSNAME="macos" ;;
  Linux) SYSNAME="linux" ;;
  esac
  case "${UNAME_M}" in
  arm64) MACHINE="arm64" ;;
  # aarch64) MACHINE="arm64" ;;
  x86_64 | x64) MACHINE="x64" ;;
  esac
  URL="https://github.com/tree-sitter/tree-sitter/releases/download/v${VERSION}/tree-sitter-cli-${SYSNAME}-${MACHINE}.zip"
  ;;
esac

BIN_DIR="${HOME}/.local/bin"
mkdir -p "${BIN_DIR}"

case "${URL}" in
*.tar.gz)
  TMP_FILE="$(mktemp -t "${TOOL}.XXXXXX").tar.gz"
  TMP_DIR="$(mktemp -d -t "${TOOL}.XXXXXX")"
  cleanup() {
    rm -f "${TMP_FILE}"
    rm -rf "${TMP_DIR}"
  }
  trap cleanup EXIT
  printf "Downloading %s\n" "${URL}"
  curl -fLsS -o "${TMP_FILE}" "${URL}"
  if [ "${XATTR_NEEDED}" = "1" ]; then
    xattr -c "${TMP_FILE}"
  fi
  if [ "${FLAT_RENAME}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    tar -xzf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ -n "${OPT_SUBDIR}" ]; then
    OPT_DIR="${HOME}/.local/opt"
    mkdir -p "${OPT_DIR}"
    printf "Extracting to %s\n" "${OPT_DIR}/${OPT_SUBDIR}"
    tar -xzf "${TMP_FILE}" -C "${TMP_DIR}"
    rm -rf "${OPT_DIR:?}/${OPT_SUBDIR}"
    mv "${TMP_DIR}"/* "${OPT_DIR}/${OPT_SUBDIR}"
    ln -sf "${OPT_DIR}/${OPT_SUBDIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ "${STRIP_SUBDIR}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    tar -xzf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}"/*/"${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  else
    printf "Extracting to %s\n" "${BIN_DIR}"
    tar -xzf "${TMP_FILE}" -C "${BIN_DIR}"
  fi
  ;;
*.tar.xz)
  TMP_FILE="$(mktemp -t "${TOOL}.XXXXXX").tar.xz"
  TMP_DIR="$(mktemp -d -t "${TOOL}.XXXXXX")"
  cleanup() {
    rm -f "${TMP_FILE}"
    rm -rf "${TMP_DIR}"
  }
  trap cleanup EXIT
  printf "Downloading %s\n" "${URL}"
  curl -fLsS -o "${TMP_FILE}" "${URL}"
  printf "Extracting to %s\n" "${BIN_DIR}"
  if [ "${STRIP_SUBDIR}" = "1" ]; then
    tar -xJf "${TMP_FILE}" -C "${TMP_DIR}"
    mv "${TMP_DIR}"/*/"${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  else
    tar -xJf "${TMP_FILE}" -C "${BIN_DIR}"
  fi
  ;;
*.zip)
  TMP_FILE="$(mktemp -t "${TOOL}.XXXXXX").zip"
  TMP_DIR="$(mktemp -d -t "${TOOL}.XXXXXX")"
  cleanup() {
    rm -f "${TMP_FILE}"
    rm -rf "${TMP_DIR}"
  }
  trap cleanup EXIT
  printf "Downloading %s\n" "${URL}"
  curl -fLsS -o "${TMP_FILE}" "${URL}"
  if [ "${XATTR_NEEDED}" = "1" ]; then
    xattr -c "${TMP_FILE}"
  fi
  if [ "${FLAT_RENAME}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    unzip -q -o "${TMP_FILE}" -d "${TMP_DIR}"
    mv "${TMP_DIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ -n "${OPT_SUBDIR}" ]; then
    OPT_DIR="${HOME}/.local/opt"
    mkdir -p "${OPT_DIR}"
    printf "Extracting to %s\n" "${OPT_DIR}/${OPT_SUBDIR}"
    unzip -q -o "${TMP_FILE}" -d "${TMP_DIR}"
    rm -rf "${OPT_DIR:?}/${OPT_SUBDIR}"
    mv "${TMP_DIR}"/* "${OPT_DIR}/${OPT_SUBDIR}"
    ln -sf "${OPT_DIR}/${OPT_SUBDIR}/${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  elif [ "${STRIP_SUBDIR}" = "1" ]; then
    printf "Extracting to %s\n" "${BIN_DIR}"
    unzip -q -o "${TMP_FILE}" -d "${TMP_DIR}"
    mv "${TMP_DIR}"/*/"${BIN_SUBPATH}" "${BIN_DIR}/${BIN_NAME}"
  else
    printf "Extracting to %s\n" "${BIN_DIR}"
    unzip -q -o "${TMP_FILE}" -d "${BIN_DIR}"
  fi
  ;;
esac

BIN_PATH="${BIN_DIR}/${BIN_NAME}"

chmod +x "${BIN_PATH}"
printf "Installed %s to %s\n" "${TOOL}" "${BIN_PATH}"

if [ "${TOOL}" = "nodejs" ]; then
  for extra_bin in npm npx; do
    ln -sf "${HOME}/.local/opt/node/bin/${extra_bin}" "${BIN_DIR}/${extra_bin}"
    printf "Also linked %s to %s\n" "${extra_bin}" "${BIN_DIR}/${extra_bin}"
  done
fi

if [ "${TOOL}" = "fish" ]; then
  for extra_bin in fish_indent fish_key_reader; do
    ln -sf "${HOME}/.local/opt/fish/Contents/Resources/base/usr/local/bin/${extra_bin}" "${BIN_DIR}/${extra_bin}"
    printf "Also linked %s to %s\n" "${extra_bin}" "${BIN_DIR}/${extra_bin}"
  done
fi
